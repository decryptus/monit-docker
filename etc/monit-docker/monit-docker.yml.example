# Optional defaults for the direct serve command (since 1.3.0).
# serve:
#   interval: 60
#   rsc: [status, health]
#   status_token_file: /run/secrets/status
vars:
  base_url_unix: unix:///var/run/docker.sock
  base_url_https: https://127.0.0.1:2376/
  tls_verify: true
clients:
  '@import_client':
    - clients.yml.example
  local_https:
    config:
      base_url: ${vars['base_url_https'] | n,my}
      tls:
        verify: ${vars.get('tls_verify', False) | n,my}
  foo_https:
    '@import_vars': foo_https.vars.yml.example
    config:
      base_url: ${vars['base_url_https'] | n,my}
ctn-groups:
  php:
    match:
      - 'name:foo-php*'
      - 'image:*/php-fpm/*'
      - 'label:*php-fpm*'
  nodejs:
    match:
      - 'id:4c01db0b339c'
      - 'name:node*'
dir-groups:
  data:
    paths:
      - /data
      - /var/log
  temporary:
    paths:
      - /tmp
      - /dev/shm
conditions:
  data_disk_full:
    expr:
      - disk_percent[data] > 90
  data_inodes_full:
    expr:
      - inode_percent[data] > 95
  data_read_only:
    expr:
      - fs_mode[data] == ro
  mem_gt_10pct_and_cpu_gt_60pct:
    expr:
      - mem_percent > 10
      - cpu_percent > 60
  mem_usage_100MiB:
    expr:
      - mem_usage > 100 MiB
  status_not_running:
    expr:
      - status not in (paused,running)
commands:
  start_pause:
    exec:
      - start
      - (sh -c "echo foo > /tmp/bar")
      - pause
  pause_restart:
    exec:
      - pause
      - restart
  remove_force:
    exec:
      - remove:
          kwargs:
            force: true

# Direct command defaults (optional, since 1.3.0). CLI flags take precedence.
# stats:
#   output: json
#   rsc: [cpu_percent, mem_usage]
# monit:
#   rsc: [status]
# cron:
#   state_file: /var/lib/monit-docker/web.json
#   cmd: ['mem_percent > 90 ? restart']
#   cooldown: 300
# Preview with: monit-docker --name web cron --dry-run
