      "targets": [
        {
          "refId": "A",
          "expr": "rate(monit_docker_container_network_receive_bytes_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\",name=~\"${container:regex}\"}[$__rate_interval])",
