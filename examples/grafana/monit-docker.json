      "title": "Cycle failures per second",
      "type": "timeseries",
      "description": "Includes Docker failures, lock contention and state errors; agent-wide.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
