    {
      "id": 12,
      "title": "Action decisions per second",
      "type": "timeseries",
      "description": "Agent-wide counts; ignores the container filter. executed, cooldown, pending and dry-run are distinct. pending counts decisions skipped by the local trigger delay.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
